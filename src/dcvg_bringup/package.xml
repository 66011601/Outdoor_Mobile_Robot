<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dcvg_bringup</name>
  <version>0.0.0</version>
  <description>Real-hardware bringup for the DCVG autonomous rover (sensors + Teensy motor bridge + RTK GPS + VIO + EKF + Nav2). dcvg_robot is the simulation counterpart.</description>
  <maintainer email="66011601@kmitl.ac.th">thana</maintainer>
  <license>TODO: License declaration</license>

  <!-- Shared navigation/localization stack (same as simulation) -->
  <depend>navigation2</depend>
  <depend>nav2_bringup</depend>
  <depend>robot_localization</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>

  <!-- VIO + depth obstacles -->
  <depend>rtabmap_odom</depend>
  <depend>rtabmap_util</depend>

  <!-- Real sensor drivers (installed on the Jetson) — no physical LiDAR in
       this build (RPLIDAR dropped); obstacle avoidance is depth-camera-only -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <!-- simpleRTK2B Heading (u-blox ZED-F9P) + NTRIP RTK corrections -->
  <exec_depend>ublox_gps</exec_depend>
  <exec_depend>ublox_msgs</exec_depend>
  <exec_depend>ntrip_client</exec_depend>
  <exec_depend>nmea_msgs</exec_depend>
  <exec_depend>rtcm_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Core ROS deps actually imported by dcvg_bringup's own nodes -->
  <depend>rclpy</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
