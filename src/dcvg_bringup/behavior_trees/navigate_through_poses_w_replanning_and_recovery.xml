
<!--
  DCVG custom recovery BT (navigate_through_poses).
  Same change as the navigate_to_pose variant: the rover BACKS UP before it
  spins during recovery, so it pulls away from depth-camera-only obstacles
  instead of grinding/pivoting into them.
  Recovery order per stuck event: Clear+replan -> BackUp -> Spin -> Wait.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- Raised from 0.333 Hz (every 3s - at 1.5 m/s the robot traveled
             4.5m on a stale route before even considering a replan). Each
             tick costs one NavFn solve over the global costmap. -->
        <RateController hz="1.5">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <!-- SmoothPath added after planning — see the navigate_to_pose
                 variant for the rationale. Wrapped in a Fallback so a smoothing
                 failure falls through to the unsmoothed path instead of
                 dropping the plan and triggering recovery. -->
            <ReactiveSequence>
              <!-- radius 1.5 -> 0.8, tracking min_lookahead_dist down from 1.5
                   to 0.45. The invariant this value has to satisfy has not
                   changed: RemovePassedGoals is PROXIMITY-based, popping goals
                   off the FRONT only while goal[0] is within radius and stopping
                   at the first one that is not — so a point the rover passes
                   WIDE by more than radius is never pruned, stays as goal[0],
                   and ComputePathThroughPoses keeps planning BACKWARD to it.
                   1.5 was sized for a rover that cut corners by ~1.5m because
                   its carrot sat that far out. With the carrot now at 0.45m the
                   rover passes intermediate points far closer, and 1.5 has
                   become actively harmful for route strictness: a segment here
                   is only ~2m long, so a 1.5m radius prunes every intermediate
                   route point on the first tick and the "path" collapses to a
                   straight line from wherever the rover is to the next stop.
                   That throws away the route SHAPE — fine on the straight test
                   route, wrong the moment the road bends. 0.8 is ~1.8x the
                   lookahead: wide enough to absorb a wide pass, tight enough
                   that the intermediate point still shapes the path.
                   Note the last goal is never pruned (the loop runs to
                   size()-1), so the segment's stop is always preserved. -->
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.8"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              <Fallback name="SmoothOrPassThrough">
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="simple_smoother"/>
                <AlwaysSuccess/>
              </Fallback>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!-- NON-EVASIVE RECOVERY. BackUp and Spin were deliberately REMOVED.
             This rover surveys a live road, where leaving the route line is the
             accident being designed against — so a recovery behaviour that
             drives the robot somewhere the route never asked it to go is a
             bigger hazard than the stall it is recovering from. BackUp 0.5m is
             uncommanded reverse motion into ground no forward-facing sensor has
             ever seen (there is no rear sensor and no LiDAR on this build), and
             Spin sweeps the chassis through a 0.75m radius on tracks, which
             both scrubs the heading estimate and puts the body somewhere the
             surveyed corridor does not cover.
             What is left cannot move the robot: clear the costmaps (recovers
             the real common case, stale depth marks from grass), then hold.
             If clearing does not unblock it, the rover genuinely cannot proceed
             on the route and the right answer is to stop and let the operator
             look — which is what route_waypoint_follower's hold_on_failure now
             does with the failure this returns.
             number_of_retries also cut 6 -> 2: six rounds of this is a minute
             of a stationary robot pretending to make progress. -->
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
