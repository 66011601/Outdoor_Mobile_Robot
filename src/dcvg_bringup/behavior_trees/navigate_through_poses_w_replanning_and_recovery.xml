
<!--
  DCVG custom recovery BT (navigate_through_poses).
  Same change as the navigate_to_pose variant: the rover BACKS UP before it
  spins during recovery, so it pulls away from depth-camera-only obstacles
  instead of grinding/pivoting into them.
  Recovery order per stuck event: Clear+replan -> BackUp -> Spin -> Wait.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- Raised from 0.333 Hz (every 3s - at 1.5 m/s the robot traveled
             4.5m on a stale route before even considering a replan). Each
             tick costs one NavFn solve over the global costmap. -->
        <RateController hz="1.5">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <!-- SmoothPath added after planning — see the navigate_to_pose
                 variant for the rationale. Wrapped in a Fallback so a smoothing
                 failure falls through to the unsmoothed path instead of
                 dropping the plan and triggering recovery. -->
            <ReactiveSequence>
              <!-- radius RAISED 0.7 -> 1.5. This is the "robot goes back to a
                   waypoint it already passed" fix.
                   RemovePassedGoals is PROXIMITY-based, not progress-based: it
                   pops goals off the FRONT only while goal[0] is within radius,
                   and stops at the first one that isn't. So a waypoint the rover
                   passed to the SIDE by more than radius is never removed — it
                   stays as goal[0], and ComputePathThroughPoses keeps planning
                   back to it. The rover was correctly following a path that
                   genuinely pointed backwards.
                   0.7 was far too tight for how this robot actually drives:
                   xy_goal_tolerance is 1.0 (RTK FLOAT-sized), and RPP steers to
                   a carrot at min_lookahead_dist 1.5, so it systematically cuts
                   inside corners and passes intermediate points by up to about
                   that much. Matching radius to min_lookahead_dist (1.5) means a
                   point the controller deliberately steered wide of still counts
                   as passed.
                   Side effect, intended: with ~1m waypoint spacing this prunes
                   1-2 points at a time, so the active goal sits ~1.5-2m ahead.
                   These are route-SHAPE points, not stops, so that is fine. -->
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="1.5"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              <Fallback name="SmoothOrPassThrough">
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="simple_smoother"/>
                <AlwaysSuccess/>
              </Fallback>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.50" backup_speed="0.15"/>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
