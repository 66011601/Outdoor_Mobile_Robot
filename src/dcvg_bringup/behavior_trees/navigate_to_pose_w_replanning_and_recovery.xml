
<!--
  DCVG custom recovery BT (navigate_to_pose).
  SUPERSEDED: recovery is now NON-EVASIVE — BackUp and Spin are gone and the
  only remaining action that touches the motors is nothing at all (clear the
  costmaps, then wait). The note below describes the previous BackUp-before-Spin
  ordering and is kept for history; see the RecoveryActions comment inline and
  the navigate_through_poses variant for why evasive recovery was dropped.

  Differs from the Nav2 default only in the recovery RoundRobin order:
  the rover BACKS UP before it spins. Spinning in place while wedged against
  an obstacle scrapes/pivots into it and throws controller errors — a bigger
  risk here since the depth camera (no LiDAR in this build) is the only
  obstacle sensor and has a blind spot close to the robot. Backing away first
  opens space so the costmap clear + replan can route around the obstacle.
  Recovery order per stuck event: Clear+replan -> BackUp -> Spin -> Wait.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- Raised from 1.0 Hz (each tick costs one NavFn solve over the
             global costmap; re-check planner_server CPU after changing). -->
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <!-- SmoothPath runs between planning and following. smoother_server
                 and simple_smoother were configured, and
                 nav2_smooth_path_action_bt_node was in plugin_lib_names, but
                 nothing ever called the action — the smoother was dead weight.
                 NavFn is 8-connected on a 0.1m grid, so its raw output has 45-deg
                 staircase steps; RPP steers at whatever the path hands it, so
                 those steps become curvature chatter.
                 Failure here is non-fatal by design: the Sequence is wrapped so
                 that if smoothing fails we fall through to the UNSMOOTHED path
                 rather than losing the plan and triggering recovery. -->
            <Sequence name="PlanThenSmooth">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <Fallback name="SmoothOrPassThrough">
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="simple_smoother"/>
                <AlwaysSuccess/>
              </Fallback>
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- BackUp and Spin REMOVED — see the navigate_through_poses variant
               for the full rationale. Short version: on a live-road survey an
               evasive recovery that drives the rover off the route line is a
               worse hazard than the stall it recovers from, and there is no
               rear-facing sensor at all on this build. Clearing the costmaps
               handles the real common case (stale depth marks from grass);
               anything it does not handle should stop for the operator. -->
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
