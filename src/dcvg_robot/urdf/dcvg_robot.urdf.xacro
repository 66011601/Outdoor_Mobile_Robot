<?xml version="1.0"?>
<robot name="dcvg_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       ROBOT PARAMETERS
       Edit the properties below to reshape the robot.
       Inertia tensors, collision margins, etc. update automatically.

       NOTE: wheel_radius and right_wheel_y / left_wheel_y are also
       hardcoded in odom.py and forward_kinematics.py — keep them in
       sync when changing those values.
       ================================================================ -->

  <!-- Base frame -->
  <xacro:property name="base_height"    value="0.08"/>     <!-- ground → base_link Z -->

  <!-- Base body -->
  <xacro:property name="mesh_scale"     value="0.1"/>      <!-- STL scale factor -->
  <xacro:property name="base_mesh_y"    value="0.105"/>    <!-- mesh centroid Y offset -->
  <xacro:property name="base_col_x"     value="1.0"/>      <!-- collision box size -->
  <xacro:property name="base_col_y"     value="0.65"/>
  <xacro:property name="base_col_z"     value="0.5"/>
  <xacro:property name="base_col_cy"    value="0.0"/>    <!-- collision centre Y -->
  <xacro:property name="base_col_cz"    value="0.2715"/>   <!-- collision centre Z -->
  <xacro:property name="base_mass"      value="10.0"/>

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius"   value="0.2"/>
  <xacro:property name="wheel_length"   value="0.122"/>
  <xacro:property name="wheel_mass"     value="2.0"/>
  <xacro:property name="wheel_x"        value="-0.12705949983365117"/>
  <xacro:property name="wheel_z"        value="0.10252579476793128"/>
  <xacro:property name="right_wheel_y"  value="-0.4009616629101749"/>
  <xacro:property name="left_wheel_y"   value="0.4"/>

  <!-- Caster wheels -->
  <xacro:property name="caster_radius"  value="0.085"/>
  <xacro:property name="caster_length"  value="0.122"/>
  <xacro:property name="caster_mass"    value="0.5"/>
  <xacro:property name="caster_x"       value="0.22"/>
  <xacro:property name="caster_z"       value="-0.015"/>
  <xacro:property name="right_caster_y" value="-0.4009616629101749"/>
  <xacro:property name="left_caster_y"  value="0.4"/>

  <!-- Circuit box -->
  <xacro:property name="box_x_size"     value="0.566"/>
  <xacro:property name="box_y_size"     value="0.4"/>
  <xacro:property name="box_z_size"     value="0.204"/>
  <xacro:property name="box_col_z"      value="0.204"/>   <!-- collision only: keeps lidar 10 cm above top -->
  <xacro:property name="box_x"          value="-0.051186530340802394"/>
  <xacro:property name="box_z"          value="0.5696926006648109"/>
  <xacro:property name="box_mass"       value="2.0"/>

  <!-- Lidar -->
  <xacro:property name="lidar_radius"   value="0.05"/>
  <xacro:property name="lidar_length"   value="0.04"/>
  <xacro:property name="lidar_x"        value="0.09919157283119712"/>
  <xacro:property name="lidar_z"        value="0.8463953295940616"/>
  <xacro:property name="lidar_mass"     value="0.2"/>

  <!-- IMU -->
  <xacro:property name="imu_size"       value="0.1"/>
  <xacro:property name="imu_z"          value="0.32499184842320095"/>
  <xacro:property name="imu_mass"       value="0.05"/>

  <!-- Depth camera (D455: 124×26×25 mm, 87° H-FOV, depth 0.6-6 m) -->
  <xacro:property name="cam_x"          value="0.52"/>
  <xacro:property name="cam_z"          value="0.82"/>
  <xacro:property name="cam_size_x"     value="0.026"/>
  <xacro:property name="cam_size_y"     value="0.124"/>
  <xacro:property name="cam_size_z"     value="0.025"/>
  <xacro:property name="cam_mass"       value="0.1"/>

  <!-- [ADDED] D457 stereo IR camera pair — 95 mm baseline (identical to D455 body)
       Left IR camera sits at +Y (robot-left), right IR camera at -Y (robot-right).
       stereo_half_base offsets each camera ±47.5 mm from the camera_link centre. -->
  <xacro:property name="stereo_half_base" value="0.0475"/>

  <!-- <xacro:property name="pi" value="3.1415926535897931" /> -->

  <!-- ================================================================
       INERTIA MACROS
       ================================================================ -->

  <!-- Solid cylinder whose axis is along its local Z -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (3*r*r + h*h) / 12}"
        iyy="${m * (3*r*r + h*h) / 12}"
        izz="${m * r*r / 2}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- Solid box a × b × c -->
  <xacro:macro name="box_inertia" params="m a b c">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (b*b + c*c) / 12}"
        iyy="${m * (a*a + c*c) / 12}"
        izz="${m * (a*a + b*b) / 12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================
       DRIVE WHEEL MACRO
       Joint name format must match dcvg_controller.py and odom.py:
       base_link_to_<name>
       ================================================================ -->

  <xacro:macro name="drive_wheel" params="name y">
    <joint name="base_link_to_${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${wheel_x} ${y} ${wheel_z}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="${name}-material">
          <color rgba="0.084 0.084 0.084 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- 5 mm radial + 10 mm axial margin for collision -->
          <cylinder radius="${wheel_radius + 0.005}" length="${wheel_length + 0.01}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
    </link>
  </xacro:macro>

  <!-- ================================================================
       CASTER WHEEL MACRO
       ================================================================ -->

  <xacro:macro name="caster_wheel" params="name y">
    <joint name="base_link_to_${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${caster_x} ${y} ${caster_z}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.1"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_length}"/>
        </geometry>
        <material name="${name}-material">
          <color rgba="0.084 0.084 0.084 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius + 0.005}" length="${caster_length + 0.01}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${caster_mass}" r="${caster_radius}" h="${caster_length}"/>
    </link>
    <gazebo reference="${name}">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ================================================================
       ROBOT STRUCTURE
       ================================================================ -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 ${base_col_cy} ${base_col_cz}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_col_x} ${base_col_y} ${base_col_z}"/>
      </geometry>
      <material name="base_link-material">
        <color rgba="0.127 0.270 0.033 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 ${base_col_cy} ${base_col_cz}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_col_x} ${base_col_y} ${base_col_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 ${base_col_cy} ${base_col_cz}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_col_y*base_col_y + base_col_z*base_col_z) / 12}"
        iyy="${base_mass * (base_col_x*base_col_x + base_col_z*base_col_z) / 12}"
        izz="${base_mass * (base_col_x*base_col_x + base_col_y*base_col_y) / 12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Drive wheels -->
  <xacro:drive_wheel name="right_wheel" y="${right_wheel_y}"/>
  <xacro:drive_wheel name="left_wheel"  y="${left_wheel_y}"/>

  <!-- Caster wheels -->
  <xacro:caster_wheel name="right_caster_front" y="${right_caster_y}"/>
  <xacro:caster_wheel name="left_caster_front"  y="${left_caster_y}"/>

  <!-- Circuit box -->
  <joint name="base_link_to_circuit_box" type="fixed">
    <parent link="base_link"/>
    <child link="circuit_box"/>
    <origin xyz="${box_x} 0 ${box_z}" rpy="0 0 0"/>
  </joint>
  <link name="circuit_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x_size} ${box_y_size} ${box_z_size}"/>
      </geometry>
      <material name="circuit_box-material">
        <color rgba="0.305 0.503 0.020 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x_size} ${box_y_size} 0"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${box_mass}" a="${box_x_size}" b="${box_y_size}" c="${box_z_size}"/>
  </link>

  <!-- Lidar -->
  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>
  <link name="lidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="lidar-material">
        <color rgba="0.130 0.095 0.019 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_length}"/>
  </link>

  <!-- Depth camera -->
  <joint name="base_link_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${cam_size_x} ${cam_size_y} ${cam_size_z}"/>
      </geometry>
      <material name="camera-material">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${cam_size_x} ${cam_size_y} ${cam_size_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${cam_mass}" a="${cam_size_x}" b="${cam_size_y}" c="${cam_size_z}"/>
  </link>

  <!-- Optical frame: ROS convention (Z forward, X right, Y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- [ADDED] Left stereo camera link — D457 IR left sensor, offset +Y from camera_link centre -->
  <joint name="camera_left_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_left"/>
    <origin xyz="0 ${stereo_half_base} 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_link_left"/>

  <!-- [ADDED] Left stereo optical frame — same ROS optical convention (Z fwd, X right, Y down) -->
  <joint name="camera_left_optical_joint" type="fixed">
    <parent link="camera_link_left"/>
    <child link="camera_optical_frame_left"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame_left"/>

  <!-- [ADDED] Right stereo camera link — D457 IR right sensor, offset -Y from camera_link centre -->
  <joint name="camera_right_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_right"/>
    <origin xyz="0 ${-stereo_half_base} 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_link_right"/>

  <!-- [ADDED] Right stereo optical frame -->
  <joint name="camera_right_optical_joint" type="fixed">
    <parent link="camera_link_right"/>
    <child link="camera_optical_frame_right"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame_right"/>

  <!-- GPS (placeholder — no visual) -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gps_link"/>

  <!-- GPS heading antenna (rover/moving-baseline board, simpleRTK2B Heading kit)
       — placeholder, no visual. Identity transform to base_link is intentional,
       not a lazy placeholder: gps_heading_to_imu.py's heading_offset_deg param
       already corrects for the real antenna-mounting misalignment before
       publishing yaw, so this frame only needs to RESOLVE (so robot_localization's
       TF lookup for the /gps/heading/imu orientation fusion succeeds) — modeling
       the real physical baseline offset between the two antennas isn't needed. -->
  <joint name="gps_heading_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_heading_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gps_heading_link"/>

  <!-- IMU -->
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
  </joint>
  <link name="imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="imu-material">
        <color rgba="1.0 0.0 0.631 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${imu_mass}" a="${imu_size}" b="${imu_size}" c="${imu_size}"/>
  </link>

  <!-- ================================================================
       GAZEBO VISUALS
       The STL mesh is too large for Gazebo to load (25 MB), so override
       base_link's visual with the same box used for collision.
       RViz still uses the full mesh via the <visual> block above.
       ================================================================ -->

  <gazebo reference="base_link">
    <visual>
      <pose>0 ${base_col_cy} ${base_col_cz} 0 0 0</pose>
      <geometry>
        <box><size>${base_col_x} ${base_col_y} ${base_col_z}</size></box>
      </geometry>
      <material>
        <ambient>0.127 0.270 0.033 1</ambient>
        <diffuse>0.127 0.270 0.033 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>

  <!-- ================================================================
       GAZEBO PLUGINS
       ================================================================ -->

  <!-- Differential drive — subscribes /cmd_vel, publishes /odom
       NOTE: when using robot_localization (EKF + GPS), set
       publish_odom_tf to false so the EKF owns that transform. -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>base_link_to_left_wheel</left_joint>
      <right_joint>base_link_to_right_wheel</right_joint>
      <wheel_separation>${left_wheel_y - right_wheel_y}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Joint state publisher — replaces dcvg_controller when in Gazebo -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=/joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>base_link_to_right_wheel</joint_name>
      <joint_name>base_link_to_left_wheel</joint_name>
      <joint_name>base_link_to_right_caster_front</joint_name>
      <joint_name>base_link_to_left_caster_front</joint_name>
    </plugin>
  </gazebo>

  <!-- Lidar — publishes sensor_msgs/LaserScan on /lidar/scan -->
  <gazebo reference="lidar">
    <sensor type="ray" name="lidar_sensor">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min> #increase
          <max>10.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="laserscan_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/lidar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU — publishes sensor_msgs/Imu on /imu/data
       Noise based on D455 BMI055 datasheet (same class as D457 ICM-42688-P):
         Gyro  noise density : 0.014 °/s/√Hz → stddev 1.7e-3 rad/s at 100 Hz
         Gyro  bias instability: ~0.5°/hr     → bias_mean 5e-4 rad/s
         Accel noise density : 150 μg/√Hz    → stddev 1.04e-2 m/s² at 100 Hz
         Accel bias (initial): ~5 mg          → bias_mean 0.05 m/s² -->
  <gazebo reference="imu">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-3</stddev><bias_mean>5e-4</bias_mean><bias_stddev>1e-4</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-3</stddev><bias_mean>5e-4</bias_mean><bias_stddev>1e-4</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-3</stddev><bias_mean>5e-4</bias_mean><bias_stddev>1e-4</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.04e-2</stddev><bias_mean>0.05</bias_mean><bias_stddev>5e-3</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.04e-2</stddev><bias_mean>0.05</bias_mean><bias_stddev>5e-3</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.04e-2</stddev><bias_mean>0.05</bias_mean><bias_stddev>5e-3</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu/data</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- GPS — publishes sensor_msgs/NavSatFix on /gps/fix
       Noise based on u-blox ZED-F9P datasheet (RTK Fixed mode with NTRIP):
         Horizontal accuracy: 0.01m RMS + 1ppm baseline → stddev 0.013m
         Vertical accuracy:   0.02m RMS (2× horizontal typical) → stddev 0.020m
         Bias (mean): 0.003m horizontal, 0.005m vertical — residual multipath/atmospheric
         Update rate: 5 Hz (F9P RTK typical output rate, vs M8N 1 Hz)

       F9P operating modes for reference:
         RTK Fixed (this):  horizontal 0.013m σ, vertical 0.020m σ  ← NTRIP converged
         RTK Float:         horizontal 0.1m σ,   vertical 0.2m σ    ← converging
         Standalone:        horizontal 1.7m σ,   vertical 2.5m σ    ← no corrections -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <gps>
        <position_sensing>
          <horizontal><noise type="gaussian"><mean>0.003</mean><stddev>0.013</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0.005</mean><stddev>0.020</stddev></noise></vertical>
        </position_sensing>
      </gps>
      <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros><remapping>~/out:=/gps/fix</remapping></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- D455 depth camera — RGB 1280×800 / Depth 1280×720, 87° H-FOV, 0.6-6 m -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="d455_depth_sensor">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>60</update_rate>
      <camera name="d455">
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 degrees, D455 depth H-FOV -->
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>   <!-- D455 min depth range -->
          <far>100.0</far>     <!-- D455 max reliable outdoor depth -->
        </clip>
        <!-- D455 depth noise: <2% at 2m, ~5% at 4m, ~8% at 6m
             Fixed stddev 0.015m represents ~1.5% average across 0.6-6m range -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.015</stddev>
        </noise>
      </camera>
      <plugin name="d455_camera_plugin" filename="libgazebo_ros_camera.so">
        <!-- camera_name sets the ROS namespace; topics publish as /d455/image_raw,
             /d455/depth/image_raw, /d455/points, /d455/camera_info, etc.
             ros remappings are ignored by this plugin — use launch remappings instead. -->
        <camera_name>d455</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <min_depth>0.6</min_depth>
        <max_depth>6.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- [FIXED] D457 left IR camera — uses libgazebo_ros_camera.so (same plugin as D455,
       confirmed working in ROS2). libgazebo_ros_multicamera.so was removed because its
       ROS2 parameter API is inconsistent and produced no topics.
       Two separate sensors fire in the same Gazebo physics step so timestamps are
       effectively identical; approx_sync with 50 ms tolerance handles any jitter.
       Publishes: /d457/left/image_raw, /d457/left/camera_info -->
  <gazebo reference="camera_link_left">
    <sensor type="camera" name="d457_left_sensor">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="d457_left">
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87° — D457 IR camera H-FOV -->
        <image>
          <width>1280</width>   <!-- D457 IR native resolution (16:9) -->
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.4</near>    <!-- D457 IR min reliable range -->
          <far>20.0</far>     <!-- beyond 20 m disparity noise dominates at 95 mm baseline -->
        </clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
      </camera>
      <plugin name="d457_left_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>d457/left</camera_name>
        <frame_name>camera_optical_frame_left</frame_name>
        <!-- no hack_baseline on left: it is the reference camera, Tx = 0 in P matrix -->
      </plugin>
    </sensor>
  </gazebo>

  <!-- [FIXED] D457 right IR camera — separate libgazebo_ros_camera.so plugin.
       hack_baseline=0.095 encodes the 95 mm D457 baseline into camera_info:
         P_right[0][3] = -fx * 0.095
       RTAB-Map stereo_odometry reads this to triangulate metric depth from disparity.
       Publishes: /d457/right/image_raw, /d457/right/camera_info -->
  <gazebo reference="camera_link_right">
    <sensor type="camera" name="d457_right_sensor">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>90</update_rate>
      <camera name="d457_right">
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.4</near>
          <far>20.0</far>
        </clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
      </camera>
      <plugin name="d457_right_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>d457/right</camera_name>
        <frame_name>camera_optical_frame_right</frame_name>
        <hack_baseline>0.095</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ground truth — publishes exact Gazebo physics pose as /ground_truth/odom
       Used only for benchmarking VIO accuracy; not fed into EKF. -->
  <gazebo>
    <plugin name="p3d_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=/ground_truth/odom</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>map</frame_name>
      <update_rate>30</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
