<?xml version="1.0"?>
<robot name="dcvg_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_imu_tilt" default="false"/>

  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="wheel_x" value="-0.12705949983365117"/>
  <xacro:property name="wheel_z" value="0.10252579476793128"/>
  <xacro:property name="caster_x" value="0.22"/>
  <xacro:property name="caster_z" value="-0.015"/>
  <xacro:property name="right_y" value="-0.4009616629101749"/>
  <xacro:property name="left_y" value="0.4"/>

  <material name="dark"><color rgba="0.084 0.084 0.084 1"/></material>
  <material name="green"><color rgba="0.127 0.270 0.033 1"/></material>
  <material name="light_green"><color rgba="0.305 0.503 0.020 1"/></material>

  <xacro:macro name="wheel" params="name x y z radius">
    <joint name="base_link_to_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${-pi/2} 0 0"/>
    </joint>
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${radius}" length="0.122"/></geometry>
        <material name="dark"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="frame" params="name x y z">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
    <link name="${name}"/>
  </xacro:macro>

  <link name="base_footprint"/>

  <xacro:if value="$(arg use_imu_tilt)">
    <link name="base_pitch_link"/>

    <joint name="base_pitch_joint" type="continuous">
      <parent link="base_footprint"/>
      <child link="base_pitch_link"/>
      <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_roll_joint" type="continuous">
      <parent link="base_pitch_link"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
    </joint>
  </xacro:if>

  <xacro:unless value="$(arg use_imu_tilt)">
    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </joint>
  </xacro:unless>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.2715" rpy="0 0 0"/>
      <geometry><box size="1.0 0.65 0.5"/></geometry>
      <material name="green"/>
    </visual>
  </link>

  <link name="circuit_box">
    <visual>
      <geometry><box size="0.566 0.4 0.204"/></geometry>
      <material name="light_green"/>
    </visual>
  </link>
  <joint name="base_link_to_circuit_box" type="fixed">
    <parent link="base_link"/>
    <child link="circuit_box"/>
    <origin xyz="-0.051186530340802394 0 0.5696926006648109" rpy="0 0 0"/>
  </joint>

  <xacro:wheel name="right_wheel" x="${wheel_x}" y="${right_y}" z="${wheel_z}" radius="0.2"/>
  <xacro:wheel name="left_wheel" x="${wheel_x}" y="${left_y}" z="${wheel_z}" radius="0.2"/>
  <xacro:wheel name="right_caster_front" x="${caster_x}" y="${right_y}" z="${caster_z}" radius="0.085"/>
  <xacro:wheel name="left_caster_front" x="${caster_x}" y="${left_y}" z="${caster_z}" radius="0.085"/>

  <xacro:frame name="camera_link" x="0.62" y="0" z="0.82"/>
  <xacro:frame name="gps_link" x="-0.62" y="0.0" z="1.15"/>
  <xacro:frame name="gps_heading_link" x="0.62" y="0.0" z="1.15"/>

</robot>
