<robot name="dcvg_robot">
  <link name="base_footprint"></link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0.105 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://dcvg_robot_description/meshes/DCVG_Robot.stl" scale="0.1 0.1 0.1" />
      </geometry>
      <material name="base_link-material">
        <color rgba="0.12743768042608497 0.2704977910022518 0.033104766565152086 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.105 0.2715012243252391" rpy="0 0 0" />
      <geometry>
        <box size="1 0.65 0.5" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.105 0.2715012243252391" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.16666666666666666" ixy="0" ixz="0" iyy="0.16666666666666666" iyz="0" izz="0.16666666666666666" />
    </inertial>
  </link>

  <joint name="base_link_to_right_wheel" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="-0.12705949983365117 -0.4009616629101749 0.10252579476793128" rpy="-1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.2" length="0.122" />
      </geometry>
      <material name="right_wheel-material">
        <color rgba="0.08437621153575764 0.08437621153575764 0.08437621153575764 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.205" length="0.132" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="1.6666666666666665" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="1.6666666666666665" />
    </inertial>
  </link>

  <joint name="base_link_to_left_wheel" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.12705949983365117 0.4 0.10252579476793128" rpy="-1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.2" length="0.122" />
      </geometry>
      <material name="left_wheel-material">
        <color rgba="0.08437621153575764 0.08437621153575764 0.08437621153575764 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.225" length="0.132" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="1.6666666666666665" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="1.6666666666666665" />
    </inertial>
  </link>

  <joint name="base_link_to_right_caster_front" type="continuous">
    <parent link="base_link" />
    <child link="right_caster_front" />
    <origin xyz="0.22 -0.4009616629101749 -0.015" rpy="-1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_caster_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.085" length="0.122" />
      </geometry>
      <material name="right_caster_front-material">
        <color rgba="0.08437621153575764 0.08437621153575764 0.08437621153575764 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.132" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="1.6666666666666665" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="1.6666666666666665" />
    </inertial>
  </link>

  <joint name="base_link_to_left_caster_front" type="continuous">
    <parent link="base_link" />
    <child link="left_caster_front" />
    <origin xyz="0.22 0.4 -0.015" rpy="-1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_caster_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.085" length="0.122" />
      </geometry>
      <material name="left_caster_front-material">
        <color rgba="0.08437621153575764 0.08437621153575764 0.08437621153575764 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.132" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="1.6666666666666665" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="1.6666666666666665" />
    </inertial>
  </link>

  <joint name="base_link_to_circuit_box" type="fixed">
    <parent link="base_link" />
    <child link="circuit_box" />
    <origin xyz="-0.051186530340802394 0 0.5696926006648109" rpy="0 0 0" />
  </joint>

  <link name="circuit_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.566 0.4 0.204" />
      </geometry>
      <material name="circuit_box-material">
        <color rgba="0.3049873140591091 0.5028864580233624 0.02028856305209031 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.566 0.4 0.204" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.16666666666666666" ixy="0" ixz="0" iyy="0.16666666666666666" iyz="0" izz="0.16666666666666666" />
    </inertial>
  </link>

  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link" />
    <child link="lidar" />
    <origin xyz="0.09919157283119712 0 0.6963953295940616" rpy="0 0 0" />
  </joint>

  <link name="lidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
      <material name="lidar-material">
        <color rgba="0.13013647668074665 0.09530746662221588 0.019382360952473074 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>

        <sensor type="lidar" name="lidar">
            <always_on>true</always_on>
            <update_rate>5</update_rate>
            <origin>0.09919157283119712 0 0.6963953295940616 0 0 0</origin>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.28</max_angle>
                    </horizontal>
                    <range>
                        <min>0.12</min>
                        <max>3.5</max>
                        <resolution>0.015</resolution>
                    </range>
                </scan>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
      </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gps_link"/>

  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link" />
    <child link="imu" />
    <origin xyz="0 0 0.32499184842320095" rpy="0 0 0" />
  </joint>
  
  <link name="imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="imu-material">
        <color rgba="1 0 0.6307571363387763 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.16666666666666666" ixy="0" ixz="0" iyy="0.16666666666666666" iyz="0" izz="0.16666666666666666" />
    </inertial>

        <sensor type="imu" name="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <origin>0 0 0.32499184842320095 0 0 0</origin>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0</stddev>
                </noise>
            </imu>
        </sensor>
      </link>
</robot>