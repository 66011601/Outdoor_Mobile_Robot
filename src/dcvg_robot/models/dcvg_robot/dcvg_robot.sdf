<sdf version="1.6">
<model name="dcvg_robot" canonical_link='base_footprint'>
  <static>false</static>
  <pose relative_to='world'>0 0 0 0 0 0</pose>

  <link name="base_footprint"/>

  <link name="base_link">
    <pose relative_to='base_footprint'>0 0 0.08 0 0 0</pose>
    <visual name='base_link visual'>
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box><size>1 0.65 0.5</size></box>
      </geometry>
      <material>
        <ambient>0.127 0.270 0.033 1</ambient>
        <diffuse>0.127 0.270 0.033 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='base_link collision'>
      <pose>0 0 0.0 0 0 0</pose>
      <geometry>
        <box><size>1 0.65 0.5</size></box>
      </geometry>
    </collision>
    <inertial>
      <mass>10</mass>
      <inertia>
        <ixx>0.3615</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>1.0854</iyy><iyz>0</iyz>
        <izz>1.1354</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent>base_footprint</parent>
    <child>base_link</child>
  </joint>

  <!-- ── Right drive wheel ───────────────────────────────────────── -->
  <link name="right_wheel">
    <pose relative_to='base_link'>-0.12705949983365117 -0.4009616629101749 0.10252579476793128 -1.5707963267948963 0 0</pose>
    <visual name='right_wheel visual'>
      <geometry>
        <cylinder><radius>0.2</radius><length>0.122</length></cylinder>
      </geometry>
      <material>
        <ambient>0.084 0.084 0.084 1</ambient>
        <diffuse>0.084 0.084 0.084 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='right_wheel collision'>
      <geometry>
        <cylinder><radius>0.205</radius><length>0.132</length></cylinder>
      </geometry>
    </collision>
    <inertial>
      <mass>2</mass>
      <inertia>
        <!-- cylinder: Ixx=Iyy=m(3r²+h²)/12, Izz=mr²/2 -->
        <ixx>0.052</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.052</iyy><iyz>0</iyz>
        <izz>0.040</izz>
      </inertia>
    </inertial>
  </link>

  <!-- continuous joint: no lower/upper position limits -->
  <joint name="base_link_to_right_wheel" type="revolute">
    <parent>base_link</parent>
    <child>right_wheel</child>
    <axis>
      <xyz expressed_in='right_wheel'>0 0 1</xyz>
      <limit><effort>20</effort></limit>
    </axis>
  </joint>

  <!-- ── Left drive wheel ────────────────────────────────────────── -->
  <link name="left_wheel">
    <pose relative_to='base_link'>-0.12705949983365117 0.4 0.10252579476793128 -1.5707963267948963 0 0</pose>
    <visual name='left_wheel visual'>
      <geometry>
        <cylinder><radius>0.2</radius><length>0.122</length></cylinder>
      </geometry>
      <material>
        <ambient>0.084 0.084 0.084 1</ambient>
        <diffuse>0.084 0.084 0.084 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='left_wheel collision'>
      <geometry>
        <!-- fixed: was 0.225 (inconsistent with right wheel) -->
        <cylinder><radius>0.205</radius><length>0.132</length></cylinder>
      </geometry>
    </collision>
    <inertial>
      <mass>2</mass>
      <inertia>
        <ixx>0.052</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.052</iyy><iyz>0</iyz>
        <izz>0.040</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="base_link_to_left_wheel" type="revolute">
    <parent>base_link</parent>
    <child>left_wheel</child>
    <axis>
      <xyz expressed_in='left_wheel'>0 0 1</xyz>
      <limit><effort>20</effort></limit>
    </axis>
  </joint>

  <!-- ── Right caster ────────────────────────────────────────────── -->
  <link name="right_caster_front">
    <pose relative_to='base_link'>0.22 -0.4009616629101749 -0.015 -1.5707963267948963 0 0</pose>
    <visual name='right_caster_front visual'>
      <geometry>
        <cylinder><radius>0.085</radius><length>0.122</length></cylinder>
      </geometry>
      <material>
        <ambient>0.084 0.084 0.084 1</ambient>
        <diffuse>0.084 0.084 0.084 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='right_caster_front collision'>
      <geometry>
        <cylinder><radius>0.09</radius><length>0.132</length></cylinder>
      </geometry>
    </collision>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0014</iyy><iyz>0</iyz>
        <izz>0.0018</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="base_link_to_right_caster_front" type="revolute">
    <parent>base_link</parent>
    <child>right_caster_front</child>
    <axis>
      <xyz expressed_in='right_caster_front'>0 0 1</xyz>
      <limit><effort>5</effort></limit>
    </axis>
  </joint>

  <!-- ── Left caster ─────────────────────────────────────────────── -->
  <link name="left_caster_front">
    <pose relative_to='base_link'>0.22 0.4 -0.015 -1.5707963267948963 0 0</pose>
    <visual name='left_caster_front visual'>
      <geometry>
        <cylinder><radius>0.085</radius><length>0.122</length></cylinder>
      </geometry>
      <material>
        <ambient>0.084 0.084 0.084 1</ambient>
        <diffuse>0.084 0.084 0.084 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='left_caster_front collision'>
      <geometry>
        <cylinder><radius>0.09</radius><length>0.132</length></cylinder>
      </geometry>
    </collision>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0014</iyy><iyz>0</iyz>
        <izz>0.0018</izz>
      </inertia>
    </inertial>
  </link>

  <joint name="base_link_to_left_caster_front" type="revolute">
    <parent>base_link</parent>
    <child>left_caster_front</child>
    <axis>
      <xyz expressed_in='left_caster_front'>0 0 1</xyz>
      <limit><effort>5</effort></limit>
    </axis>
  </joint>

  <!-- ── Circuit box ─────────────────────────────────────────────── -->
  <link name="circuit_box">
    <pose relative_to='base_link'>-0.051186530340802394 0 0.5696926006648109 0 0 0</pose>
    <visual name='circuit_box visual'>
      <geometry><box><size>0.566 0.4 0.204</size></box></geometry>
      <material>
        <ambient>0.305 0.503 0.020 1</ambient>
        <diffuse>0.305 0.503 0.020 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='circuit_box collision'>
      <pose relative_to='base_link'>-0.051186530340802394 0 0.5696926006648109 0 0 0</pose>
      <geometry><box><size>0.566 0.4 0.204</size></box></geometry>
    </collision>
    <inertial>
      <mass>2</mass>
      <inertia>
        <ixx>0.035</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.057</iyy><iyz>0</iyz>
        <izz>0.057</izz>
      </inertia>
    </inertial>
  </link>
  <joint name="base_link_to_circuit_box" type="fixed">
    <parent>base_link</parent>
    <child>circuit_box</child>
  </joint>

  <!-- ── Lidar ───────────────────────────────────────────────────── -->
  <link name="lidar">
    <pose relative_to='base_link'>0.09919157283119712 0 0.8463953295940616 0 0 0</pose>
    <visual name='lidar visual'>
      <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
      <material>
        <ambient>0.130 0.095 0.019 1</ambient>
        <diffuse>0.130 0.095 0.019 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='lidar collision'>
      <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
    </collision>
    <inertial>
      <mass>0.2</mass>
      <inertia>
        <ixx>0.000087</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.000087</iyy><iyz>0</iyz>
        <izz>0.00025</izz>
      </inertia>
    </inertial>
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min><max>10.0</max><resolution>0.015</resolution>
        </range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="laserscan_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/lidar/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </link>
  <joint name="base_link_to_lidar" type="fixed">
    <parent>base_link</parent>
    <child>lidar</child>
  </joint>

  <!-- ── GPS ─────────────────────────────────────────────────────── -->
  <link name="gps_link">
    <pose relative_to='base_link'>0 0 0 0 0 0</pose>
    <inertial>
      <mass>0.125</mass>
      <inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz>
        <izz>0.001</izz>
      </inertia>
    </inertial>
    <sensor name="gps_sensor" type="gps">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <gps>
        <position_sensing>
          <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></vertical>
        </position_sensing>
      </gps>
      <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros><remapping>~/out:=/gps/fix</remapping></ros>
      </plugin>
    </sensor>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent>base_link</parent>
    <child>gps_link</child>
  </joint>

  <!-- ── IMU ─────────────────────────────────────────────────────── -->
  <link name="imu">
    <pose relative_to='base_link'>0 0 0.32499184842320095 0 0 0</pose>
    <visual name='imu visual'>
      <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
      <material>
        <ambient>1.0 0.0 0.631 1</ambient>
        <diffuse>1.0 0.0 0.631 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <collision name='imu collision'>
      <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
    </collision>
    <inertial>
      <mass>0.05</mass>
      <inertia>
        <ixx>0.0000417</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0000417</iyy><iyz>0</iyz>
        <izz>0.0000417</izz>
      </inertia>
    </inertial>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <!-- fixed: was imu/imu — should be imu/data for robot_localization -->
        <ros><remapping>~/out:=/imu/data</remapping></ros>
      </plugin>
    </sensor>
  </link>
  <joint name="base_link_to_imu" type="fixed">
    <parent>base_link</parent>
    <child>imu</child>
  </joint>

  <!-- ── Gazebo plugins ──────────────────────────────────────────── -->

  <!-- Differential drive controller -->
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
    <update_rate>30</update_rate>
    <left_joint>base_link_to_left_wheel</left_joint>
    <right_joint>base_link_to_right_wheel</right_joint>
    <wheel_separation>0.8009616629101749</wheel_separation>
    <wheel_diameter>0.4</wheel_diameter>
    <max_wheel_torque>20</max_wheel_torque>
    <max_wheel_acceleration>1.0</max_wheel_acceleration>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
  </plugin>

  <!-- Joint state publisher -->
  <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <remapping>~/out:=/joint_states</remapping>
    </ros>
    <update_rate>30</update_rate>
    <joint_name>base_link_to_right_wheel</joint_name>
    <joint_name>base_link_to_left_wheel</joint_name>
    <joint_name>base_link_to_right_caster_front</joint_name>
    <joint_name>base_link_to_left_caster_front</joint_name>
  </plugin>

</model>
</sdf>
