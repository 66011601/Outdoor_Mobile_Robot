<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- A global light source -->
    <scene>
      <ambient>0.95 0.95 0.95 1</ambient>
      <background>0.3 0.3 0.3 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>3</speed>
        </clouds>
      </sky>
    </scene>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://sonoma_raceway</uri>
      <pose>-287.5 143.5 -7 0 0 0</pose>
    </include>
    <spherical_coordinates>
      <!-- currently gazebo has a bug: instead of outputing lat, long, altitude in ENU
      (x = East, y = North and z = Up) as the default configurations, it's outputting (-E)(-N)U,
      therefore we rotate the default frame 180 so that it would go back to ENU 
      see: https://github.com/osrf/gazebo/issues/2022 --> 
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>38.161479</latitude_deg>
      <longitude_deg>-122.454630</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>
    
    <physics type="ode">
      <real_time_update_rate>100.0</real_time_update_rate>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="short_grass_1">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.025 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>1.5</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.35 0.80 0.20 1</ambient><diffuse>0.35 0.80 0.20 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>1.5</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="tall_grass_1">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.45 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>0.90</length></cylinder></geometry>
          <material><ambient>0.05 0.35 0.05 1</ambient><diffuse>0.05 0.35 0.05 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>0.25</radius><length>0.90</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="rock_1">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.25 0 0 0.4</pose>
        <visual name="v">
          <geometry><box><size>0.8 0.6 0.5</size></box></geometry>
          <material><ambient>0.50 0.45 0.40 1</ambient><diffuse>0.55 0.50 0.45 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.8 0.6 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="tree_1">
      <static>true</static>
      <link name="trunk">
        <pose>0 0 2.0 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.35 0.20 0.05 1</ambient><diffuse>0.40 0.25 0.10 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>0.15</radius><length>4.0</length></cylinder></geometry>
        </collision>
      </link>
      <link name="canopy">
        <pose>0 0 4.9 0 0 0</pose>
        <visual name="v">
          <geometry><sphere><radius>0.9</radius></sphere></geometry>
          <material><ambient>0.00 0.38 0.00 1</ambient><diffuse>0.00 0.42 0.00 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><sphere><radius>0.9</radius></sphere></geometry>
        </collision>
      </link>
    </model>





  </world>
</sdf>