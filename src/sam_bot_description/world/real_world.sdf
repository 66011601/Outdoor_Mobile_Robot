            <diffuse>0.55 0.47 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== TREES ======================== -->
    <!--
      Trunk: brown cylinder, radius=0.15m, height=1.5m (collision present — lidar detects trunk)
      Canopy: green sphere, visual only (no collision — trunk is what nav2 avoids)

      Inner ring  (dist ~3.2m from origin): trees 1-4  — within lidar range 3.5m
      Middle ring (dist ~5-6.5m):          trees 5-12
      Outer ring  (dist ~7-8.5m):          trees 13-20

      All corridors between nearest neighbours are >= 3m centre-to-centre.
    -->

    <!-- === Inner ring === -->

    <!-- Tree 1: NE inner (2, 2.5) dist=3.20m -->
    <model name="tree_1">
      <static>1</static>
      <pose>2 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_col">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.5</length></cylinder></geometry>
