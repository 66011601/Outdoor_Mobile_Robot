<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="park_world">

    <!-- ======================== LIGHTING ======================== -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <!-- ======================== PHYSICS ======================== -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <wind/>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================== SCENE ======================== -->
    <scene>
      <ambient>0.5 0.55 0.5 1</ambient>
      <background>0.53 0.81 0.98 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Bangkok coordinates — ready for GPS plugin later -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>13.7294</latitude_deg>
      <longitude_deg>100.7787</longitude_deg>
      <elevation>3</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ======================== GROUND ======================== -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== PAVED PATHS (cosmetic) ======================== -->
    <!-- North-South path — robot spawns at the intersection (0,0) -->
    <model name="path_ns">
      <static>1</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 20.0 0.01</size></box></geometry>
          <material>
            <ambient>0.76 0.74 0.68 1</ambient>
            <diffuse>0.76 0.74 0.68 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- East-West path -->
    <model name="path_ew">
      <static>1</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20.0 2.0 0.01</size></box></geometry>
          <material>
            <ambient>0.76 0.74 0.68 1</ambient>
            <diffuse>0.76 0.74 0.68 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== BOUNDARY WALLS ======================== -->
    <!-- Height 1.0m — above lidar plane, robot cannot cross -->

    <model name="wall_north">
      <static>1</static>
      <pose>0 9.85 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 0.3 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.3 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.47 0.38 1</ambient>
            <diffuse>0.55 0.47 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>1</static>
      <pose>0 -9.85 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 0.3 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.3 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.47 0.38 1</ambient>
            <diffuse>0.55 0.47 0.38 1</diffuse>
          </material>
        </visual>
