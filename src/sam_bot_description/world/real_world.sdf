          <geometry><cylinder><radius>0.12</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.38 0.20 0.05 1</ambient><diffuse>0.38 0.20 0.05 1</diffuse></material>
        </visual>
        <visual name="canopy">
