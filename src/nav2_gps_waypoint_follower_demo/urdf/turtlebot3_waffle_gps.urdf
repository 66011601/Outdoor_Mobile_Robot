<?xml version="1.0"?>
<robot name="turtlebot3_waffle" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ════════════════════════════════════════════════════════════
       SCALE — change this one value to resize the entire robot.
       All geometry, joints, inertia, and drive params scale with it.
       ════════════════════════════════════════════════════════════ -->
  <xacro:property name="scale" value="1.0"/>

  <!-- Base chassis (original dimensions at scale=1) -->
  <xacro:property name="base_joint_z"  value="0.010"/>
  <xacro:property name="body_x_offset" value="-0.064"/>
  <xacro:property name="body_z_offset" value="0.047"/>
  <xacro:property name="body_size_x"   value="0.266"/>
  <xacro:property name="body_size_y"   value="0.266"/>
  <xacro:property name="body_size_z"   value="0.094"/>

  <!-- Wheels -->
  <xacro:property name="wheel_y_offset"   value="0.144"/>
  <xacro:property name="wheel_z_offset"   value="0.023"/>
  <xacro:property name="wheel_radius"     value="0.033"/>
  <xacro:property name="wheel_length"     value="0.018"/>
  <xacro:property name="wheel_separation" value="0.287"/>

  <!-- Casters -->
  <xacro:property name="caster_x_offset" value="-0.177"/>
  <xacro:property name="caster_y_offset" value="0.064"/>
  <xacro:property name="caster_z_offset" value="-0.004"/>
  <xacro:property name="caster_size_x"   value="0.030"/>
  <xacro:property name="caster_size_y"   value="0.009"/>
  <xacro:property name="caster_size_z"   value="0.020"/>

  <!-- IMU -->
  <xacro:property name="imu_z_offset" value="0.068"/>

  <!-- LiDAR — scan_z_offset raised above body_z_offset+body_size_z/2 for clearance -->
  <xacro:property name="scan_x_offset" value="-0.064"/>
  <xacro:property name="scan_z_offset" value="0.150"/>
  <xacro:property name="scan_radius"   value="0.055"/>
  <xacro:property name="scan_length"   value="0.0315"/>

  <!-- Camera -->
  <xacro:property name="cam_x_offset"  value="0.064"/>
  <xacro:property name="cam_y_offset"  value="-0.065"/>
  <xacro:property name="cam_z_offset"  value="0.080"/>
  <xacro:property name="cam_body_x"    value="0.003"/>
  <xacro:property name="cam_body_y"    value="0.065"/>
  <xacro:property name="cam_body_z"    value="0.007"/>
  <xacro:property name="cam_size_x"    value="0.012"/>
  <xacro:property name="cam_size_y"    value="0.132"/>
  <xacro:property name="cam_size_z"    value="0.020"/>
  <xacro:property name="cam_rgb_x"     value="0.005"/>
  <xacro:property name="cam_rgb_y"     value="0.018"/>
  <xacro:property name="cam_rgb_z"     value="0.013"/>
  <xacro:property name="cam_depth_y"   value="0.028"/>
  <xacro:property name="cam_baseline"  value="0.07"/>

  <!-- Inertial base values (scale=1); mass scales by s³, inertia by s⁵ -->
  <xacro:property name="body_mass" value="1.3729096"/>
  <xacro:property name="body_ixx"  value="8.7002718e-03"/>
  <xacro:property name="body_ixy"  value="-4.7576583e-05"/>
  <xacro:property name="body_ixz"  value="1.1160499e-04"/>
  <xacro:property name="body_iyy"  value="8.6195418e-03"/>
  <xacro:property name="body_iyz"  value="-3.5422299e-06"/>
  <xacro:property name="body_izz"  value="1.4612727e-02"/>

  <xacro:property name="wheel_mass" value="2.8498940e-02"/>
  <xacro:property name="wheel_ixx"  value="1.1175580e-05"/>
  <xacro:property name="wheel_ixy"  value="-4.2369783e-11"/>
  <xacro:property name="wheel_ixz"  value="-5.9381719e-09"/>
  <xacro:property name="wheel_iyy"  value="1.1192413e-05"/>
  <xacro:property name="wheel_iyz"  value="-1.4400107e-11"/>
  <xacro:property name="wheel_izz"  value="2.0712558e-05"/>

  <xacro:property name="caster_mass"    value="0.005"/>
  <xacro:property name="caster_inertia" value="0.001"/>
  <xacro:property name="scan_mass"      value="0.114"/>
  <xacro:property name="scan_inertia"   value="0.001"/>

  <!-- Drive plugin base values -->
  <xacro:property name="max_wheel_torque_base" value="20.0"/>
  <xacro:property name="max_wheel_accel_base"  value="1.0"/>

  <!-- Materials -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="light_black"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.4235 0.0392 1.0"/></material>
  <material name="brown"><color rgba="0.8706 0.8118 0.7647 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${scale * base_joint_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${scale * body_x_offset} 0 ${scale * body_z_offset}" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * body_size_x} ${scale * body_size_y} ${scale * body_size_z}"/>
      </geometry>
      <material name="light_black"/>
    </visual>
    <collision>
      <origin xyz="${scale * body_x_offset} 0 ${scale * body_z_offset}" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * body_size_x} ${scale * body_size_y} ${scale * body_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${body_mass * scale**3}"/>
      <inertia ixx="${body_ixx * scale**5}" ixy="${body_ixy * scale**5}" ixz="${body_ixz * scale**5}"
               iyy="${body_iyy * scale**5}" iyz="${body_iyz * scale**5}"
               izz="${body_izz * scale**5}"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 ${scale * wheel_y_offset} ${scale * wheel_z_offset}" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * wheel_length}" radius="${scale * wheel_radius}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * wheel_length}" radius="${scale * wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${wheel_mass * scale**3}"/>
      <inertia ixx="${wheel_ixx * scale**5}" ixy="${wheel_ixy * scale**5}" ixz="${wheel_ixz * scale**5}"
               iyy="${wheel_iyy * scale**5}" iyz="${wheel_iyz * scale**5}"
               izz="${wheel_izz * scale**5}"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 ${-scale * wheel_y_offset} ${scale * wheel_z_offset}" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * wheel_length}" radius="${scale * wheel_radius}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * wheel_length}" radius="${scale * wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${wheel_mass * scale**3}"/>
      <inertia ixx="${wheel_ixx * scale**5}" ixy="${wheel_ixy * scale**5}" ixz="${wheel_ixz * scale**5}"
               iyy="${wheel_iyy * scale**5}" iyz="${wheel_iyz * scale**5}"
               izz="${wheel_izz * scale**5}"/>
    </inertial>
  </link>

  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="${scale * caster_x_offset} ${-scale * caster_y_offset} ${scale * caster_z_offset}" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_right_link">
    <collision>
      <origin xyz="0 ${scale * 0.001} 0" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * caster_size_x} ${scale * caster_size_y} ${scale * caster_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${caster_mass * scale**3}"/>
      <inertia ixx="${caster_inertia * scale**5}" ixy="0.0" ixz="0.0"
               iyy="${caster_inertia * scale**5}" iyz="0.0"
               izz="${caster_inertia * scale**5}"/>
    </inertial>
  </link>

  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="${scale * caster_x_offset} ${scale * caster_y_offset} ${scale * caster_z_offset}" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_left_link">
    <collision>
      <origin xyz="0 ${scale * 0.001} 0" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * caster_size_x} ${scale * caster_size_y} ${scale * caster_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${caster_mass * scale**3}"/>
      <inertia ixx="${caster_inertia * scale**5}" ixy="0.0" ixz="0.0"
               iyy="${caster_inertia * scale**5}" iyz="0.0"
               izz="${caster_inertia * scale**5}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0 ${scale * imu_z_offset}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- GPS link provides a static transform for GPS sensor -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gps_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="${scale * scan_x_offset} 0 ${scale * scan_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * scan_length}" radius="${scale * scan_radius}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${scale * scan_length}" radius="${scale * scan_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${scan_mass * scale**3}"/>
      <inertia ixx="${scan_inertia * scale**5}" ixy="0.0" ixz="0.0"
               iyy="${scan_inertia * scale**5}" iyz="0.0"
               izz="${scan_inertia * scale**5}"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="${scale * cam_x_offset} ${scale * cam_y_offset} ${scale * cam_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="${scale * cam_body_x} ${scale * cam_body_y} ${scale * cam_body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * cam_size_x} ${scale * cam_size_y} ${scale * cam_size_z}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="${scale * cam_body_x} ${scale * cam_body_y} ${scale * cam_body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${scale * cam_size_x} ${scale * cam_size_y} ${scale * cam_size_z}"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="${scale * cam_rgb_x} ${scale * cam_rgb_y} ${scale * cam_rgb_z}" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="${scale * cam_rgb_x} ${scale * cam_depth_y} ${scale * cam_rgb_z}" rpy="-1.57 0 -1.57"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- Gazebo link materials -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="wheel_left_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>100000.0</mu1>
    <mu2>100000.0</mu2>
    <kp>1e+5</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>100000.0</mu1>
    <mu2>100000.0</mu2>
    <kp>1e+5</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="caster_back_right_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1e+6</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="caster_back_left_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1e+6</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <ros><remapping>~/out:=imu</remapping></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- GPS sensor -->
  <gazebo reference="gps_link">
    <sensor name="tb3_gps" type="gps">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <gps>
        <position_sensing>
          <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></vertical>
        </position_sensing>
      </gps>
      <plugin name="my_gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros><remapping>~/out:=/gps/fix</remapping></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- LiDAR sensor — single block, sensor at link origin (no dip), min_range clears chassis -->
  <gazebo reference="base_scan">
    <material>Gazebo/DarkGrey</material>
    <sensor name="hls_lfcd_lds" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth camera — single block so Gazebo processes both material and sensor -->
  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <sensor name="intel_realsense_r200_depth" type="depth">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <camera name="realsense_depth_camera"/>
      <plugin name="intel_realsense_r200_depth_driver" filename="libgazebo_ros_camera.so">
        <ros/>
        <camera_name>intel_realsense_r200_depth</camera_name>
        <frame_name>camera_depth_frame</frame_name>
        <hack_baseline>${scale * cam_baseline}</hack_baseline>
        <min_depth>0.001</min_depth>
        <max_depth>5.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Differential drive — kinematics and torque scale with robot size -->
  <gazebo>
    <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>/tf:=tf</remapping></ros>
      <update_rate>30</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${scale * wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * scale * wheel_radius}</wheel_diameter>
      <max_wheel_torque>${max_wheel_torque_base * scale**4}</max_wheel_torque>
      <max_wheel_acceleration>${max_wheel_accel_base * scale}</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
